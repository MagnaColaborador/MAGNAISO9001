<p style="margin:0 0 20px;font-size:16px;font-weight:600;color:#111827;">Olá {{nome}},</p>
{{#each paragrafos}}
<p style="margin:0 0 16px;">{{this}}</p>
{{/each}}

{{#if detalhes.length}}
<table role="presentation" cellpadding="0" cellspacing="0" style="margin:8px 0 28px;border-collapse:collapse;">
  {{#each detalhes}}
  <tr>
    <td style="padding:4px 16px 4px 0;font-size:13px;color:#6B7280;vertical-align:top;">{{this.label}}</td>
    <td style="padding:4px 0;font-size:13px;font-weight:600;color:#111827;">{{this.valor}}</td>
  </tr>
  {{/each}}
</table>
{{/if}}

<div style="height:1px;background-color:#F0EDE6;margin:0 0 24px;"></div>

<p style="margin:0;color:#111827;">
  Cumprimentos,<br/>
  <a href="{{link}}" style="color:#C8932F;font-weight:600;text-decoration:none;">Aceder à Requisição de Salas</a>
</p>
